#!/usr/bin/env python3
# -*- coding: utf-8 -*-
import sys
import json
import os
import configparser
import ipaddress
import requests
from requests.auth import HTTPBasicAuth
import datetime
from pathlib import PureWindowsPath, PurePosixPath

# ====== CONFIGURATION ======
OPNSENSE_HOST = "https://gw.ad.structureality.com"
OPNSENSE_API_KEY = None
OPNSENSE_API_SECRET = None
VERIFY_TLS = True

ALIAS_NAME = "SHUNNED"
ALIAS_TYPE = "host"
ALIAS_DESCRIPTION = "Auto-managed by Wazuh active response"
FIREWALL_RULE_DESCRIPTION = "Block SHUNNED IPs (auto-managed by Wazuh)"
FIREWALL_RULE_ACTION = "block"
FIREWALL_RULE_DIRECTION = "in"
OS_SUCCESS = 0
OS_INVALID = -1
AR_NAME = __file__

if os.name == 'nt':
    LOG_FILE = "C:\\Program Files (x86)\\ossec-agent\\active-response\\active-responses.log"
else:
    LOG_FILE = "/var/ossec/logs/active-responses.log"

def write_debug_file(ar_name, msg):
    with open(LOG_FILE, mode="a") as log_file:
        log_file.write(str(datetime.datetime.now().strftime('%Y/%m/%d %H:%M:%S')) + " " + ar_name + ": " + msg +"\n")

# ====== WAZUH ACTIVE RESPONSE I/O ======

def read_active_response_input():
    data = sys.stdin.read()
    if not data:
        write_debug_file(AR_NAME, f"DEBUG: No data on stdin")
        return {}
    try:
        write_debug_file(AR_NAME, f"DEBUG: Raw AR input: {data}")
        return json.loads(data)
    except json.JSONDecodeError as e:
        write_debug_file(AR_NAME, f"DEBUG: JSON decode error: {e}")
        return {}

def extract_ip_from_alert(ar_input):
    try:
        params = ar_input.get("parameters", {})
        alert = params.get("alert", {})
        data_sec = alert.get("data", {})
        ip_str = data_sec.get("dest_ip")
        if not ip_str:
            return None
        ip_str = ip_str.strip()
        ipaddress.ip_address(ip_str)  # validate
        return ip_str
    except Exception as e:
        write_debug_file(AR_NAME, f"DEBUG: extract_ip_from_alert error: {e}")
        return None

# ====== OPNsense API HELPERS ======

def get_apikey():
    global OPNSENSE_API_KEY, OPNSENSE_API_SECRET
    config = configparser.ConfigParser()
    config.read("/var/ossec/etc/opnsense.cfg")

    try:
        OPNSENSE_API_KEY = config["opnsense"]["api_key"]
        OPNSENSE_API_SECRET = config["opnsense"]["api_secret"]
    except KeyError as e:
        write_debug_file(AR_NAME, f"Missing config value: {e}")
        sys.exit(1)

def get_auth():
    if OPNSENSE_API_KEY and OPNSENSE_API_SECRET:
        return HTTPBasicAuth(OPNSENSE_API_KEY, OPNSENSE_API_SECRET)
    raise RuntimeError("No valid OPNsense authentication configured")

def opnsense_get(path, params=None):
    url = f"{OPNSENSE_HOST}{path}"
    resp = requests.get(url, auth=get_auth(), params=params, verify=VERIFY_TLS, timeout=15)
    resp.raise_for_status()
    return resp.json()

def opnsense_post(path, payload=None):
    url = f"{OPNSENSE_HOST}{path}"
    resp = requests.post(url, auth=get_auth(), json=payload, verify=VERIFY_TLS, timeout=30)
    resp.raise_for_status()
    try:
        return resp.json()
    except ValueError:
        return {"raw": resp.text}

# ====== ALIAS MANAGEMENT ======

def find_alias(alias_name):
    path = f"/api/firewall/alias/get_alias_uuid/{alias_name}"
    alias_uuid = opnsense_get(path)
    return alias_uuid
    
def create_alias(alias_name, alias_type, description):
    payload = {
        "alias": {
            "name": alias_name,
            "type": alias_type,
            "description": description,
            "content": "",
            "enabled": "1",
        }
    }
    return opnsense_post("/api/firewall/alias/add_item", payload)

def add_ip_to_alias(alias_name, alias_type, description, ip):
    alias_uuid = find_alias(alias_name)
    if not alias_uuid:
        write_debug_file(AR_NAME, f"DEBUG: Alias {alias_name} not found, creating")
        create_alias(alias_name, alias_type, description)
        alias_uuid = find_alias(alias_name)
        if not alias_uuid:
            raise RuntimeError("Failed to create alias on OPNsense")
    path = f"/api/firewall/alias_util/add/{alias_name}"
    payload = {"address": ip}
    
    return opnsense_post(path, payload)

# ====== FIREWALL RULE MANAGEMENT ======

def find_shun_rule_uuid(description, interface, alias_name, use_destination=False):
    params = {}
    if description:
        params["description"] = description
    if interface:
        params["interface"] = interface
    if alias_name:
        if use_destination:
            params["destination_net"] = alias_name
        else:
            params["source_net"] = alias_name

    rule_uuid = None
    data = opnsense_get("/api/firewall/filter/search_rule", params=params)
    if isinstance(data, dict):
        rows = data.get("rows") or []
        if len(rows) == 1:
            rule_uuid = rows[0]["uuid"]

    return rule_uuid

def add_firewall_rule(description, interface, alias_name, use_destination=False):
    rule = {
        "enabled": "1",
        "action": FIREWALL_RULE_ACTION,
        "interface": interface,
        "direction": FIREWALL_RULE_DIRECTION,
        "ipprotocol": "inet46",
        "protocol": "any",
        "description": description
    }

    if use_destination:
        rule["destination_net"] = alias_name
    else:
        rule["source_net"] = alias_name

    payload = {"rule": rule}
    resp = opnsense_post("/api/firewall/filter/add_rule", payload)
    return resp

def ensure_firewall_rule_enabled(description, interface, alias_name, use_destination=False):
    rule_uuid = find_shun_rule_uuid(description, interface, alias_name, use_destination=use_destination)
    if not rule_uuid:
        loc = "destination" if use_destination else "source"
        write_debug_file(AR_NAME, f"SHUNNED firewall rule not found on {interface} ({loc} = {alias_name}), creating")
        add_firewall_rule(description, interface, alias_name, use_destination=use_destination)
        rule_uuid = find_shun_rule_uuid(description, interface, alias_name, use_destination=use_destination)
        if not rule_uuid:
            raise RuntimeError(f"Failed to create firewall rule on OPNsense for {interface} ({loc} = {alias_name})")

    write_debug_file(AR_NAME, f"Ensured firewall rule {rule_uuid} is enabled on {interface}")
    return rule_uuid

# ====== MAIN ======

def main(argv):
    try:
        ar_input = read_active_response_input()
        ip = extract_ip_from_alert(ar_input)
        write_debug_file(AR_NAME, f"Configuring shun action for {ip}")

        if not ip:
            write_debug_file(AR_NAME, f"No valid data.dest_ip found in alert; nothing to do.")
            return

        get_apikey()

        alias = add_ip_to_alias(ALIAS_NAME, ALIAS_TYPE, ALIAS_DESCRIPTION, ip)
        write_debug_file(AR_NAME, f"Ensured alias {ALIAS_NAME} ({alias}) contains {ip}")

        # WAN rule: SHUNNED as source
        rule_uuid = ensure_firewall_rule_enabled(
            FIREWALL_RULE_DESCRIPTION, "wan", ALIAS_NAME, use_destination=False
        )
        write_debug_file(
            AR_NAME,
            f"Ensured firewall rule for {ALIAS_NAME} ({rule_uuid}) exists on wan interface with source_net and is enabled"
        )

        # LAN rule: SHUNNED as destination
        rule_uuid = ensure_firewall_rule_enabled(
            FIREWALL_RULE_DESCRIPTION, "lan", ALIAS_NAME, use_destination=True
        )
        write_debug_file(
            AR_NAME,
            f"Ensured firewall rule for {ALIAS_NAME} ({rule_uuid}) exists on lan interface with destination_net and is enabled"
        )

        apply_resp = opnsense_post("/api/firewall/filter/apply")
        write_debug_file(AR_NAME, f"Applied firewall changes: {apply_resp}")

        sys.exit(OS_SUCCESS)

    except Exception as e:
        write_debug_file(AR_NAME, f"Error in opnsense_shun.py: {e}")


if __name__ == "__main__":
    main(sys.argv)
